# Puerto local del backend
PORT=3000

# Base de datos SQLite.
# La ruta es relativa a la carpeta "prisma/", por lo que el archivo
# se crea en: backend/prisma/data/dev.db
DATABASE_URL="file:./data/dev.db"

# Clave para firmar los tokens JWT (cámbiala en producción).
JWT_SECRET="dev-secret-change-me"
